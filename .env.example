# Environment variables — copy to .env

# PostgreSQL (required). Use Neon, Vercel Postgres, or Supabase in production.
# Example: postgresql://user:password@host/db?sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

JWT_SECRET="change-this-to-a-random-secret-in-production"
ADMIN_EMAIL="admin@phonefarm.fun"
ADMIN_PASSWORD="admin123456"
# NEXT_PUBLIC_SITE_URL="https://www.phonefarm.fun"  # Canonical production origin (sitemap, canonical, JSON-LD)
# TRON_API_KEY=""  # TronGrid API key for USDT TRC20 auto-verification (server only)
# CRON_SECRET=""   # Optional: protect /api/cron/payment-poll on Vercel
# TELEGRAM_BOT_TOKEN=""       # Optional: Telegram bot token for contact-form alerts
# TELEGRAM_NOTIFY_CHAT_ID=""  # Chat ID to receive new inquiry notifications
